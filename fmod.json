{
    "duplicateStrategies": {
        "gradle.properties": "properties"
    },

    "facetPlatform": "FABRIC",

    "remap": {
        "tinyJar": "https://maven.fabricmc.net/net/fabricmc/intermediary/1.21.1/intermediary-1.21.1-v2.jar",
        "tinyPath": "mappings/mappings.tiny",
        "from": "intermediary",
        "to": "official"
    },

    "retain": [".gradle", "run"],
    "extract": {
        "src/main/resources/fabric.mod.json": "resources/fabric.mod.json",
        "src/main/resources/modid.mixins.json": "resources/%flatmod:rootid%.mixins.json",
        ".gitignore": ".gitignore"
    },

    "indirect" : {
        "maven": [
            "https://maven.fabricmc.net",
            "https://repo.maven.apache.org/maven2/",
            "https://plugins.gradle.org/m2",
            "https://libraries.minecraft.net/"
        ],
        "require": [
            "maven@net.fabricmc:fabric-loader 0.20.1"
        ]
    },

    "init": {
        "maven": [],
        "require": [
            "maven@net.fabricmc.fabric-api:fabric-api 0.116.17+1.21.1"
        ]
    }
}